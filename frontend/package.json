{
  "name": "@tekton/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "lint": "eslint . && node scripts/check-i18n.mjs",
    "typecheck": "vue-tsc -b",
    "api-types": "node scripts/generate-api-types.mjs",
    "api-types:check": "node scripts/generate-api-types.mjs --check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format:check": "prettier --check .",
    "i18n:check": "node scripts/check-i18n.mjs"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.104.0",
    "openapi-fetch": "^0.14.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.17",
    "vue-i18n": "^11.1.11",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@playwright/test": "^1.54.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "~6.9.1",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^24.0.10",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-vue": "^10.3.0",
    "eslint-plugin-vuejs-accessibility": "^2.4.1",
    "globals": "^16.3.0",
    "happy-dom": "^18.0.1",
    "msw": "^2.10.2",
    "openapi-typescript": "^7.8.0",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.36.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.12"
  }
}
