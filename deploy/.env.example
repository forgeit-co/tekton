# Port allocation: 8080 is the base; each worktree can set TEKTON_PORT_OFFSET.
TEKTON_HOST_PORT=8080
TEKTON_PORT_OFFSET=0
TEKTON_UID=10001
TEKTON_GID=10001

# File secrets live in deploy/secrets/ and are created by `just init`.
TEKTON_CONFIGURATION_PATH=/app/deploy/backend.toml
TEKTON_SECRETS_DIRECTORY=/run/secrets

# Internal service identity for the MinIO console-free S3 endpoint.
MINIO_ROOT_USER_FILE=/run/secrets/s3-root-user
MINIO_ROOT_PASSWORD_FILE=/run/secrets/s3-root-password
S3_ENDPOINT_URL=http://s3:9000
S3_REGION=us-east-1
